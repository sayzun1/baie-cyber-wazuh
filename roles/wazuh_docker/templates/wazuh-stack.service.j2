# =====================================================================
# Wazuh — généré par Ansible pour {{ inventory_hostname }}
# -----------------------------------------------------------------------------
# Les conteneurs ont déjà « restart: always » dans le compose, donc Docker
# les relance seul. Cette unité sert à autre chose : donner une commande
# unique et propre pour arrêter ou relancer TOUTE la stack —
#   systemctl stop wazuh-stack
#   systemctl restart wazuh-stack
# plutôt que de devoir se souvenir du chemin du compose.
# =====================================================================

[Unit]
Description=Stack Wazuh {{ wazuh_version }} ({{ wazuh_deployment }})
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ wazuh_stack_dir }}

# Démarrage long au premier boot : l'indexer doit ouvrir ses index.
TimeoutStartSec=900
TimeoutStopSec=300

ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart

[Install]
WantedBy=multi-user.target
